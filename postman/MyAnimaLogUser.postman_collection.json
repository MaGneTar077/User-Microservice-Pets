            "key": "token",
            "value": "{{access_token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "05 · Contexto de clínica",
      "item": [
        {
          "name": "POST Obtener token de clínica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{user_url}}/auth/context/veterinary/{{veterinaryId}}",
              "host": [
                "{{user_url}}"
              ],
              "path": [
                "auth",
                "context",
                "veterinary",
                "{{veterinaryId}}"
              ]
            },
            "description": "Emite un token de contexto de clinica si el usuario es empleado activo. Requiere JWT de usuario.\n\nErrores: 403 `NOT_A_VETERINARY_MEMBER`, 403 `VETERINARY_REJECTED`, 403 `VETERINARY_SUSPENDED`, 503 si Veterinary no responde.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{clinic_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('clinic_token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Volver a token de usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{user_url}}/auth/context/user",
              "host": [
                "{{user_url}}"
              ],
              "path": [
                "auth",
                "context",
                "user"
              ]
            },
            "description": "Vuelve a un token normal (`ctx=USER`), revocando el refresh de clinica anterior si viene en el body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{clinic_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('access_token', body.token);",
                  "pm.environment.set('refresh_token', body.refreshToken);",
                  "pm.environment.set('clinic_token', '');"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{access_token}}",
            "type": "string"
          }
        ]
      }
    },
